{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  // หมายเหตุ: ไม่ใส่ rewrites สำหรับ SPA fallback — Framework Preset (Vite)
  // จัดการให้เองแบบ function-aware ถ้าใส่ /(.*) เองจะบัง /api/* แล้ว POST จะโดนตอบ 405
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30
    }
  }
}
