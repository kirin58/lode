# ===== Neon connection string =====
# Neon Console → โครงการของคุณ → Connection Details → "Pooled connection" หรือ "Direct connection"
# ต้องขึ้นต้นด้วย postgresql://
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.us-east-2.aws.neon.tech/lostfound?sslmode=require

# ===== JWT =====
JWT_SECRET=เปลี่ยนเป็นสตริงยาว ๆ สุดมั่ว

# ===== Server (ใช้ตอน dev ในเครื่องเท่านั้น) =====
PORT=8787

# ===== Neon S3 (อัปโหลดรูป — ใช้ได้ทั้ง local และ Vercel) =====
# ดูค่าใน Neon Console → Storage (bucket) + S3 access keys
# ถ้าไม่ตั้ง → local ใช้อัปโหลดลงไฟล์, บน Vercel จะปิดอัปโหลดรูป
#AWS_ENDPOINT_URL_S3=https://xxx.storage.c-4.ap-southeast-1.aws.neon.tech
#AWS_ACCESS_KEY_ID=nak_live_...
#AWS_SECRET_ACCESS_KEY=nsk_live_...
#AWS_REGION=ap-southeast-1
#S3_BUCKET=ชื่อ-bucket-ใน-Neon-Storage
