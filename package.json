{
  "name": "lost-and-found",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lost & Found สำหรับมหาวิทยาลัย — Vue 3 + Tailwind CSS + Neon (Postgres)",
  "scripts": {
    "dev": "concurrently -n API,WEB -c magenta,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch scripts/dev-server.ts",
    "dev:client": "vite",
    "dev:e2e": "concurrently -n E2E-API,E2E-WEB -c yellow,green \"npm run dev:server\" \"npm run dev:client -- --port 5175 --strictPort\"",
    "check": "node scripts/check.mjs",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "db:push": "tsx scripts/db-push.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "deploy": "vercel --prod",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "ci": "npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vueuse/core": "^15.0.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@vercel/node": "^16.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsdom": "^30.1.1",
    "multer": "^2.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
